# TAXII server environment — copy this file to `.env` (same directory as
# server.py) and fill in real values. `.env` is git-ignored; never commit it.
#
# How it works:
#   - server.py loads `.env` at startup (minimal built-in loader, no
#     python-dotenv dependency).
#   - Existing process env vars ALWAYS win over values here (so `export`
#     in a shell or systemd Environment= still overrides).
#   - Values are picked up by the ${VAR} / ${VAR:-default} placeholders in
#     config.yaml. A missing .env file is fine — the defaults apply.
#   - To use a file elsewhere: set TAXII_ENV_FILE=/path/to/your.env

# --- Security (session/cookie signing) — REQUIRED -------------------------
# Without a value the app logs a WARNING and session cookies won't be
# signable. Generate one:  python3 -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET=

# --- TAXII client credentials (what Vision One uses on /taxii2/) -----------
# Referenced by taxii.auth in config.yaml as ${TAXII_AUTH_USER}/${TAXII_AUTH_PASSWORD}.
# If unset, the app logs a WARNING and /taxii2/ rejects every client.
# Generate:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
TAXII_AUTH_USER=
TAXII_AUTH_PASSWORD=

# --- Optional: additional TAXII collections (per-client RBAC) -------------
# Only used if you enable multi-collection mode (taxii.collections: in
# config.yaml). One USER/PASSWORD pair per extra collection:
#PREMIUM_TAXII_USER=
#PREMIUM_TAXII_PASS=

# --- Optional: feed-wide admin credential (taxii.admin_auth) --------------
# Only needed if a SCRIPT must purge/delete/revoke/ingest without using the
# dashboard login. A consumer credential (TAXII_AUTH_USER/PASSWORD, what
# Vision One holds) is READ-ONLY outside the collection it can read. Leave
# these empty and do feed-wide writes from the dashboard, or reuse the UI
# credentials via `curl -u "$UI_AUTH_USER:$UI_AUTH_PASSWORD"`.
#TAXII_ADMIN_USER=
#TAXII_ADMIN_PASSWORD=

# --- Optional: AlienVault OTX API key (community intel puller) -------------
# Referenced by otx.api_key in config.yaml as ${OTX_API_KEY:-}. Free key from
# otx.alienvault.com raises the public rate limits. Leave empty for
# anonymous read-only browsing (works, throttled).
OTX_API_KEY=

# --- TAXII Get Objects response shape (taxii.objects_shape) ----------------
# envelope = spec TAXII 2.1 Message Resource; bundle = OTX-compatible
# ({type,objects,more,next} at the top level, no envelope). Trend Micro
# Vision One only ingests the "bundle" shape — keep this set unless you add a
# spec-strict client.
TAXII_OBJECTS_SHAPE=bundle

# --- Web UI login credentials (the dashboard at /) --------------------------
# Referenced by ui.auth in config.yaml as ${UI_AUTH_USER}/${UI_AUTH_PASSWORD}.
# If unset, the app logs a WARNING and /ui/login rejects everyone (fail-closed).
UI_AUTH_USER=
UI_AUTH_PASSWORD=

# --- SSO: Microsoft Entra ID (only needed when sso.enabled: true) --------
# The client secret VALUE from Azure portal (Certificates & secrets).
# config.yaml references it as ${SSO_CLIENT_SECRET:-} under sso:client_secret.
SSO_CLIENT_SECRET=

# --- Database (only needed if you point config.yaml at a real DB) --------
# Used by the postgres/mysql connection strings shown in config.yaml.
#DB_USER=
#DB_PASS=
#DB_HOST=
#DB_PORT=
#DB_NAME=

# --- Docker Compose (docker-compose.yml) ---------------------------------
# Only read by `docker compose`; the app container gets the values injected.
# Generate a strong DB password:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_USER=taxii
POSTGRES_PASSWORD=
POSTGRES_DB=taxii_feed

# Cloudflare Tunnel token — Zero Trust -> Networks -> Tunnels -> your tunnel ->
# "Install and run a connector" -> the value after `--token`. Leave empty to
# run the stack without the tunnel (it starts only under `--profile tunnel`).
CLOUDFLARE_TUNNEL_TOKEN=

# Host port the app is published on (bound to 127.0.0.1 only). Default 5000.
TAXII_HOST_PORT=5000
